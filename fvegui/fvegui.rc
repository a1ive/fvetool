#include <winres.h>
#include "resource.h"

#pragma code_page(65001)

IDI_FVEGUI_APP ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "A1ive"
            VALUE "FileDescription", "FVEUnlocker"
            VALUE "InternalName", "fvegui"
            VALUE "OriginalFilename", "fvegui.exe"
            VALUE "ProductName", "FVEUnlocker"
            VALUE "ProductVersion", "0.0.3.0"
            VALUE "LegalCopyright", "Copyright (c) 2026 A1ive"
        END
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "A1ive"
            VALUE "FileDescription", "FVEUnlocker"
            VALUE "InternalName", "fvegui"
            VALUE "OriginalFilename", "fvegui.exe"
            VALUE "ProductName", "FVEUnlocker"
            VALUE "ProductVersion", "0.0.3.0"
            VALUE "LegalCopyright", "Copyright (c) 2026 A1ive"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200, 0x0804, 1200
    END
END

